<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>CognitiveDynamics.EzLLMRouter.Client</PackageId>
    <Version>0.3.0</Version>
    <RootNamespace>CognitiveDynamics.EzLLMRouter</RootNamespace>
    <Description>Execution and external accounting client for CognitiveDynamics EzLLMRouter.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Schemas/*.json" LogicalName="CognitiveDynamics.EzLLMRouter.Schemas.%(Filename)%(Extension)" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
