{
  "name": "@cognitivedynamics/ezllmrouter-client",
  "version": "0.3.0",
  "private": true,
  "description": "CognitiveDynamics EzLLMRouter typed CommonJS and ESM network client",
  "type": "commonjs",
  "main": "./index.cjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      },
      "default": "./index.cjs"
    }
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "index.d.cts",
    "contracts.d.cts",
    "index.cjs",
    "http.cjs",
    "successor.cjs",
    "integration.cjs",
    "integration_schema.json",
    "integration_schema_v2.json",
    "integration_schema_v3.json",
    "dev12_schemas.json"
  ],
  "scripts": {
    "test": "python3 -I -S ../../tests/client_languages/check_javascript.py",
    "test:http": "python3 -I -S ../../tests/client_languages/check_javascript.py --http",
    "test:types": "bash ../../tests/client_languages/check_typescript.sh"
  }
}
