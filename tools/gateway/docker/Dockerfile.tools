# Independent stdlib-only driver/receiver; image digest is a required build arg.
ARG DKR_PYTHON_TOOLS_BASE
FROM ${DKR_PYTHON_TOOLS_BASE}
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY --chown=0:0 harness/driver.py harness/receiver.py harness/fixtures.json /app/trusted/
RUN --network=none sh -ec 'mkdir -p /evidence; chown 10001:10001 /evidence; chmod 0555 /app; find /app/trusted -type d -exec chmod 0555 {} +; find /app/trusted -type f -exec chmod 0444 {} +'
USER 10001:10001
ENTRYPOINT ["python", "-I", "-B"]
