ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY receiver.py /app/receiver.py
RUN chmod 0555 /app && chmod 0444 /app/receiver.py \
 && mkdir -p /data && chown 10001:10001 /data \
 && rm -rf /usr/local/lib/python3.12/site-packages/pip /usr/local/lib/python3.12/site-packages/pip-*.dist-info \
      /usr/local/lib/python3.12/ensurepip /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12
USER 10001:10001
RUN test -r /app/receiver.py
CMD ["python", "/app/receiver.py"]
