ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 LANGUAGE=C
RUN --network=none --mount=type=bind,source=os-inputs,target=/opt/ezllmrouter/os-inputs,readonly \
    sh /opt/ezllmrouter/os-inputs/install.sh
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_CONFIG_FILE=/dev/null
COPY wheels/ /opt/ezllmrouter/wheels/
COPY wheelhouse.sha256 /opt/ezllmrouter/wheelhouse.sha256
COPY requirements.client.lock /opt/ezllmrouter/requirements.client.lock
RUN cd /opt/ezllmrouter/wheels && sha256sum -c /opt/ezllmrouter/wheelhouse.sha256 \
 && python -m pip install --no-index --find-links=/opt/ezllmrouter/wheels --only-binary=:all: \
      --require-hashes -r /opt/ezllmrouter/requirements.client.lock \
 && python -m pip check \
 && rm -rf /opt/ezllmrouter/wheels \
      /usr/local/lib/python3.12/site-packages/pip /usr/local/lib/python3.12/site-packages/pip-*.dist-info \
      /usr/local/lib/python3.12/ensurepip /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12
COPY actors/ /app/actors/
RUN find /app/actors -type d -exec chmod 0555 {} + \
 && find /app/actors -type f -exec chmod 0444 {} + \
 && chmod 0555 /app
USER 10001:10001
WORKDIR /app/actors
RUN test -r /app/actors/python_actor.py && test -r /app/actors/python_text.py \
 && test -r /app/actors/python_negative.py && test -r /app/actors/request.json \
 && test -r /app/actors/scenarios.json && test -r /app/actors/dev07_actor.py
RUN python -B -c "import ezllmrouter_client, httpx; assert ezllmrouter_client.__version__ == '0.3.0'"
CMD ["python", "-c", "import time; time.sleep(3600)"]
