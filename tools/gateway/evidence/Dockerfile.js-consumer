ARG NODE_IMAGE
FROM ${NODE_IMAGE}
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 LANGUAGE=C
ENV GLIBC_TUNABLES=glibc.pthread.stack_cache_size=0:glibc.malloc.arena_max=1
RUN --network=none --mount=type=bind,source=os-inputs,target=/opt/ezllmrouter/os-inputs,readonly \
    sh /opt/ezllmrouter/os-inputs/install.sh
ENV npm_config_cache=/tmp/ezllmrouter-npm-cache npm_config_audit=false npm_config_fund=false npm_config_update_notifier=false
COPY client.tgz /opt/ezllmrouter/client.tgz
RUN mkdir -p /app/consumer \
 && cd /app/consumer \
 && npm install /opt/ezllmrouter/client.tgz --offline --ignore-scripts --no-audit --no-fund --no-package-lock \
 && rm -rf /opt/ezllmrouter/client.tgz /tmp/ezllmrouter-npm-cache /usr/local/lib/node_modules /opt/yarn-* \
 && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY actors/ /app/consumer/
RUN find /app/consumer -maxdepth 1 -type f -exec chmod 0444 {} + \
 && chmod 0555 /app /app/consumer
USER node
WORKDIR /app/consumer
RUN test -r /app/consumer/js_text.cjs && test -r /app/consumer/js_actor.cjs \
 && test -r /app/consumer/scenarios.json && test -r /app/consumer/request.json \
 && test -r /app/consumer/dev07_actor.cjs
RUN node -e "if (typeof require('@cognitivedynamics/ezllmrouter-client').EzLLMRouterClient !== 'function') process.exit(1)"
CMD ["node", "-e", "setInterval(()=>{},3600000)"]
