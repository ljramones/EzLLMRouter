ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 LANGUAGE=C
RUN --network=none --mount=type=bind,source=os-inputs,target=/opt/ezllmrouter/os-inputs,readonly \
    sh /opt/ezllmrouter/os-inputs/install.sh
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_CONFIG_FILE=/dev/null \
    PYTHONPATH=/app/server:/app/gateway:/app/dev_slice
COPY wheels/ /opt/ezllmrouter/wheels/
COPY wheelhouse.sha256 /opt/ezllmrouter/wheelhouse.sha256
COPY requirements.gateway.lock /opt/ezllmrouter/requirements.gateway.lock
RUN cd /opt/ezllmrouter/wheels && sha256sum -c /opt/ezllmrouter/wheelhouse.sha256 \
 && python -m pip install --no-index --find-links=/opt/ezllmrouter/wheels --only-binary=:all: \
      --require-hashes -r /opt/ezllmrouter/requirements.gateway.lock \
 && python -m pip check \
 && rm -rf /opt/ezllmrouter/wheels
COPY server/ /app/server/
COPY gateway/ /app/gateway/
COPY dev_slice/ /app/dev_slice/
# Staging uses umask 077. Keep trusted code readable, but not writable, by UID 10001.
RUN find /app/server /app/gateway /app/dev_slice -type d -exec chmod 0555 {} + \
 && find /app/server /app/gateway /app/dev_slice -type f -exec chmod 0444 {} + \
 && chmod 0555 /app \
 && mkdir -p /data /link && chown 10001:10001 /data /link
USER 10001:10001
WORKDIR /app
RUN test -r /app/server/ezllmrouter_server/core.py && test -r /app/server/ezllmrouter_server/gateway/guard.py
CMD ["python", "/app/gateway/service_fixture.py", "asgi"]
