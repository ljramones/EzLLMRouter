  "reviews": {
    "DEBIAN-CVE-2010-4756": {
      "condition": "native_patterns",
      "ecosystem": "Debian:13",
      "source": "glibc",
      "source_version": "2.41-12+deb13u5",
      "advisory_sha256": "f188299951f6f59f361046110848b4d5f15096e4e4fc03938e26a962842757e7",
      "cna_sha256": "9104bc5077e2d52af544e7cc63d06b7a52381d542410fafbbdf5fbd7c5187cf8",
      "reason": "The exact owned server/worker source has no native-call, process-execution or dynamic-code entry point. Full ELF dependency closure, including every installed Python extension and its dependencies, has no imported glibc glob/regex caller. Python re/pathlib use their own matching implementations. The prior worker bundled Kerberos callers; the reduced exact-version libpq bundle removes them. System CLI tools are outside the qualified application execution path. This decision applies only to the recorded profile, not arbitrary native plugins or command execution.",
      "references": [
        "https://security-tracker.debian.org/tracker/CVE-2010-4756"
      ]
    },
