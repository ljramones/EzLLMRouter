ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_CONFIG_FILE=/dev/null \
    PYTHONPATH=/app/worker
ENV EZLLMROUTER_WORKER_SOCKET=/link/worker/worker.sock \
    EZLLMROUTER_SENDER_SOCKET=/link/sender/sender.sock
COPY wheelhouse.sha256 requirements.gateway.lock /opt/ezllmrouter/
RUN --mount=type=bind,source=wheels,target=/opt/ezllmrouter/wheels,readonly \
    cd /opt/ezllmrouter/wheels && sha256sum -c /opt/ezllmrouter/wheelhouse.sha256 \
 && python -m pip install --no-index --find-links=/opt/ezllmrouter/wheels --only-binary=:all: \
      --require-hashes -r /opt/ezllmrouter/requirements.gateway.lock \
 && python -m pip check
COPY --chmod=0555 ezllmrouter_worker /app/worker/ezllmrouter_worker
RUN chmod 0555 /app && mkdir -p /link/worker /link/sender && chown -R 10001:10001 /link
USER 10001:10001
WORKDIR /app
RUN test -r /app/worker/ezllmrouter_worker/__main__.py && test ! -e /app/server \
 && test ! -e /app/dev_slice && test ! -e /app/gateway
RUN --network=none --mount=type=bind,source=test_provider_worker_target.py,target=/tmp/test_provider_worker_target.py,readonly \
    python -B /tmp/test_provider_worker_target.py
RUN --network=none --mount=type=bind,source=validation,target=/tmp/validation,readonly \
    PYTHONPATH=/tmp/validation:/tmp/validation/server:/app/worker python -B /tmp/validation/test_alt_handler.py \
 && PYTHONPATH=/tmp/validation:/tmp/validation/server:/app/worker python -B /tmp/validation/test_cache_frozen_usage.py
CMD ["python", "-m", "ezllmrouter_worker"]
