ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_CONFIG_FILE=/dev/null \
    PYTHONPATH=/app/worker
COPY wheelhouse.sha256 requirements.gateway.lock /opt/ezllmrouter/
RUN --mount=type=bind,source=wheels,target=/opt/ezllmrouter/wheels,readonly \
    cd /opt/ezllmrouter/wheels && sha256sum -c /opt/ezllmrouter/wheelhouse.sha256 \
 && python -m pip install --no-index --find-links=/opt/ezllmrouter/wheels --only-binary=:all: \
      --require-hashes -r /opt/ezllmrouter/requirements.gateway.lock \
 && python -m pip check
COPY --chmod=0555 choice_b_worker.py choice_b_wire.py worker_logging.py runtime_resources.py local_worker.py socket_lease.py /app/worker/
RUN chmod 0555 /app && mkdir -p /link && chown 10001:10001 /link
USER 10001:10001
WORKDIR /app
RUN test -r /app/worker/local_worker.py && test ! -e /app/server \
 && test ! -e /app/dev_slice && test ! -e /app/gateway
RUN --network=none --mount=type=bind,source=test_provider_worker_target.py,target=/tmp/test_provider_worker_target.py,readonly \
    python -B /tmp/test_provider_worker_target.py
CMD ["python", "/app/worker/local_worker.py"]
