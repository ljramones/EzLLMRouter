ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_CONFIG_FILE=/dev/null \
    PYTHONPATH=/app/worker
COPY wheels/ /opt/duranki/wheels/
COPY wheelhouse.sha256 /opt/duranki/wheelhouse.sha256
COPY requirements.gateway.lock /opt/duranki/requirements.gateway.lock
RUN cd /opt/duranki/wheels && sha256sum -c /opt/duranki/wheelhouse.sha256 \
 && python -m pip install --no-index --find-links=/opt/duranki/wheels --only-binary=:all: \
      --require-hashes -r /opt/duranki/requirements.gateway.lock \
 && python -m pip check \
 && rm -rf /opt/duranki/wheels
COPY choice_b_worker.py choice_b_wire.py local_worker.py socket_lease.py test_provider_worker_target.py /app/worker/
RUN find /app/worker -type d -exec chmod 0555 {} + \
 && find /app/worker -type f -exec chmod 0444 {} + \
 && chmod 0555 /app \
 && mkdir -p /link && chown 10001:10001 /link
USER 10001:10001
WORKDIR /app
RUN test -r /app/worker/local_worker.py && test ! -e /app/server \
 && test ! -e /app/dev_slice && test ! -e /app/gateway
RUN --network=none python -B /app/worker/test_provider_worker_target.py
CMD ["python", "/app/worker/local_worker.py"]
