ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE} AS dependencies
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_CONFIG_FILE=/dev/null \
    PYTHONPATH=/app/server:/app/local:/app
COPY wheelhouse.sha256 requirements.gateway.lock client-wheel.sha256 /opt/ezllmrouter/
RUN --mount=type=bind,source=wheels,target=/opt/ezllmrouter/wheels,readonly \
    --mount=type=bind,source=client,target=/opt/ezllmrouter/client,readonly \
    cd /opt/ezllmrouter/wheels && sha256sum -c /opt/ezllmrouter/wheelhouse.sha256 \
 && python -m pip install --no-index --find-links=/opt/ezllmrouter/wheels --only-binary=:all: \
      --require-hashes -r /opt/ezllmrouter/requirements.gateway.lock \
 && sha256sum -c /opt/ezllmrouter/client-wheel.sha256 \
 && python -m pip install --no-index --no-deps /opt/ezllmrouter/client/*.whl \
 && python -m pip check \
 && python -B -c "import importlib.metadata,json; p=json.load(open('/opt/ezllmrouter/client/metadata.json')); assert importlib.metadata.version(p['distribution']) == p['version']"

FROM dependencies AS validation
ENV PYTHONPATH=/app/server:/app/gateway:/app/dev_slice:/app/local:/app
COPY --chmod=0555 server/ /app/server/
COPY --chmod=0555 gateway/ /app/gateway/
COPY --chmod=0555 dev_slice/ /app/dev_slice/
COPY --chmod=0555 local/ /app/local/
COPY --chmod=0555 web/ /app/web/
COPY --chmod=0555 tests/ /app/tests/
USER 10001:10001
WORKDIR /app
RUN --network=none python -B -c "from ezllmrouter_server.core import Coordinator; from ezllmrouter_server.registry import Registry; from ezllmrouter_server.gateway.choice_b_sender import ChoiceBSenderAdapter" \
 && test -r /app/local/local_service.py && test -r /app/web/index.html
RUN --network=none python -B /app/gateway/dev07_target_preflight.py \
 && python -B /app/gateway/dev08_integrated.py --preflight
RUN --network=none python -B -m unittest discover -s /app/gateway -p test_guard.py \
 && python -B /app/gateway/test_retry_cause.py --source-root /app \
 && python -B /app/gateway/test_work_identity.py --source-root /app \
 && python -B /app/gateway/test_alt_handler.py
RUN --network=none python -B -m unittest tests.operator_console.test_attribution \
    tests.operator_console.test_dev09_reporting tests.operator_console.test_dev09_http \
    tests.operator_console.test_registry_core

FROM dependencies AS runtime
COPY --from=validation /app/server/ /app/server/
COPY --from=validation /app/web/ /app/web/
COPY --from=validation /app/dev_slice/fixture.json /app/dev_slice/fixture.json
COPY --from=validation /app/local/local_service.py /app/local/initialize_credentials.py /app/local/socket_lease.py /app/local/request.json /app/local/scenarios.json /app/local/build-identity.json /app/local/
RUN chmod 0555 /app \
 && mkdir -p /data /link /console /run/ezllmrouter \
 && chown 10001:10001 /data /link /console /run/ezllmrouter
USER 10001:10001
WORKDIR /app
RUN test ! -e /app/tests && test ! -e /app/gateway && test ! -e /opt/ezllmrouter/wheels
CMD ["python", "/app/local/local_service.py"]
