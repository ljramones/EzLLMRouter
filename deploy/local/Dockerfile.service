ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_CONFIG_FILE=/dev/null \
    PYTHONPATH=/app/server:/app/gateway:/app/dev_slice:/app/local
COPY wheels/ /opt/duranki/wheels/
COPY wheelhouse.sha256 /opt/duranki/wheelhouse.sha256
COPY requirements.gateway.lock /opt/duranki/requirements.gateway.lock
COPY client/ /opt/duranki/client/
COPY client-wheel.sha256 /opt/duranki/client-wheel.sha256
RUN cd /opt/duranki/wheels && sha256sum -c /opt/duranki/wheelhouse.sha256 \
 && python -m pip install --no-index --find-links=/opt/duranki/wheels --only-binary=:all: \
      --require-hashes -r /opt/duranki/requirements.gateway.lock \
 && sha256sum -c /opt/duranki/client-wheel.sha256 \
 && python -m pip install --no-index --no-deps /opt/duranki/client/*.whl \
 && python -m pip check \
 && python -B -c "import importlib.metadata,json; p=json.load(open('/opt/duranki/client/metadata.json')); assert importlib.metadata.version(p['distribution']) == p['version']" \
 && rm -rf /opt/duranki/wheels /opt/duranki/client
COPY server/ /app/server/
COPY gateway/ /app/gateway/
COPY dev_slice/ /app/dev_slice/
COPY local/ /app/local/
COPY web/ /app/web/
COPY tests/ /app/tests/
RUN find /app/server /app/gateway /app/dev_slice /app/local /app/web /app/tests -type d -exec chmod 0555 {} + \
 && find /app/server /app/gateway /app/dev_slice /app/local /app/web /app/tests -type f -exec chmod 0444 {} + \
 && chmod 0555 /app \
 && mkdir -p /data /link /console /run/duranki && chown 10001:10001 /data /link /console /run/duranki
USER 10001:10001
WORKDIR /app
RUN test -r /app/server/duranki_server/core.py && test -r /app/server/duranki_server/registry.py \
 && test -r /app/server/duranki_server/gateway/guard.py \
 && test -r /app/local/local_service.py && test -r /app/web/index.html
RUN python -B /app/gateway/dev07_target_preflight.py
RUN --network=none python -B /app/gateway/dev08_integrated.py --preflight
RUN python -B -m unittest discover -s /app/gateway -p test_guard.py \
 && python -B /app/gateway/test_retry_cause.py --source-root /app \
 && python -B /app/gateway/test_work_identity.py --source-root /app \
 && python -B /app/gateway/test_alt_handler.py
RUN --network=none python -B -m unittest tests.operator_console.test_attribution \
    tests.operator_console.test_dev09_reporting tests.operator_console.test_dev09_http \
    tests.operator_console.test_registry_core
CMD ["python", "/app/local/local_service.py"]
