  "valid_mutations": {
    "POST /operator/v1/login": {
      "body": {
        "username": "admin",
        "password": "A private test passphrase!"
      }
    },
    "POST /operator/v1/users": {
      "body": {
        "username": "matrix.created",
        "display_name": "Matrix Created",
        "role": "ordinary",
        "status": "active",
        "password": "Synthetic matrix password 2026!"
      }
    },
    "POST /operator/v1/account/password": {
      "body": {
        "current_password": "A private test passphrase!",
        "new_password": "Synthetic changed matrix password!"
      }
    },
    "POST /operator/v1/users/*": {
      "body": {
        "username": "admin",
        "display_name": "Matrix Administrator",
        "role": "registry_admin",
        "status": "active",
        "expected_revision": 1
      }
    },
    "POST /operator/v1/local-connectors": {
      "body": {
        "display_name": "Matrix connector",
        "kind": "ollama",
        "base_url": "http://127.0.0.1:11434"
      }
    },
    "POST /operator/v1/local-connectors/*": {
      "body": {
        "display_name": "Matrix connector",
        "kind": "ollama",
        "base_url": "http://127.0.0.1:11434",
        "expected_revision": 1
      }
    },
    "POST /operator/v1/integration/*": {
      "body": {
        "dataset_id": "dataset.synthetic.matrix",
        "platform_id": "platform.synthetic",
        "environment_id": "env.synthetic",
        "owner_id": "owner.local",
        "ingest_principal_id": "svc.matrix.ingest",
        "activated_at": "2026-11-20T00:00:00Z"
      }
    },
    "POST /operator/v1/logout": {
      "body": {}
    },
    "POST /operator/v1/registry": {
      "body": {
        "operation_id": "op.matrix.grant",
        "action": "set_grant",
        "subject": "svc.demo",
        "expected_revision": 1,
        "data": {
          "configuration_ref": "cfg.demo",
          "allowed": true
        }
      }
    },
    "POST /operator/v1/personal-campaign": {
      "body": {
        "action": "closed"
      }
    },
    "POST /operator/v1/provider-credential": {
      "body": {
        "operation_id": "op.matrix.credential",
        "connection_id": "conn.synthetic",
        "expected_revision": 1,
        "mode": "replace",
        "secret": "Synthetic-matrix-provider-key-only"
      }
    },
    "POST /operator/v1/provider-probe": {
      "body": {
        "operation_id": "op.matrix.probe",
        "connection_id": "conn.synthetic",
        "expected_revision": 1,
        "operation": "inventory"
      }
    },
    "POST /operator/v1/provider-validation": {
      "body": {
        "operation_id": "op.matrix.validation",
        "connection_id": "conn.synthetic",
        "connection_revision": 1,
        "configuration_ref": "cfg.demo",
        "configuration_revision": 1,
        "max_output_tokens": 1,
        "acknowledge_external_send": true
      }
    },
    "POST /operator/v1/provision": {
      "body": {
        "operation_id": "op.matrix.provision",
        "principal_id": "svc.demo",
        "expected_revision": 1
      }
    },
    "POST /operator/v1/demos/*": {
      "body": {
        "operation_id": "op.matrix.demo"
      }
    },
    "DELETE /operator/v1/users/*": {
      "body": {
        "expected_revision": 1
      }
    },
    "DELETE /operator/v1/local-connectors/*": {
      "body": {
        "expected_revision": 1
      }
    }
  },
  "integration_status_overrides": {
    "GET /operator/v1/integration/identity": {
      "admin": 200
    }
  }
