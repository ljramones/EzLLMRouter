{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ezllmrouter.invalid/contracts/wp-a/v0.1/schema-bundle",
  "title": "EzLLMRouter WP-A proposed contract schemas",
  "description": "Inert candidate. These shapes do not authenticate, authorize, classify, sign, or implement dispatch. The .invalid host is a non-resolving identifier placeholder to be replaced at adoption.",
  "contract_status": "PROPOSED_NOT_ADOPTED",
  "entrypoints": {
    "submit_request": "#/$defs/SubmitRequest",
    "submit_ack": "#/$defs/SubmitAck",
    "status_query": "#/$defs/StatusQuery",
    "status_snapshot": "#/$defs/StatusSnapshot",
    "cancel_request": "#/$defs/CancelRequest",
    "cancel_ack": "#/$defs/CancelAck",
    "outcome_event": "#/$defs/OutcomeEvent",
    "outcome_ack": "#/$defs/OutcomeAck",
    "capability_response": "#/$defs/CapabilityResponse",
    "internal_plan": "#/$defs/ExecutionPlan",
    "internal_candidate": "#/$defs/PreparedCandidate",
    "internal_intent": "#/$defs/DispatchIntent",
    "internal_attempt": "#/$defs/AttemptRecord",
    "internal_usage_revision": "#/$defs/UsageRevision"
  },
  "$defs": {
    "Id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "Version": {"type": "string", "const": "0.1"},
    "Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "UtcTime": {"type": "string", "format": "date-time"},
    "Decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "SafeCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "Purpose": {"enum": ["execution", "feature_extraction", "verification", "judging", "evaluation", "replay"]},
    "Sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
    "SourceLabels": {
      "type": "object", "additionalProperties": false,
      "required": ["lineage_ids", "sensitivity", "restrictions"],
      "properties": {
        "lineage_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}},
        "sensitivity": {"$ref": "#/$defs/Sensitivity"},
        "restrictions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
        "policy_version": {"$ref": "#/$defs/Id"}
      }
    },
    "Reference": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "reference_id", "content_version", "source_labels"], "properties": {"kind": {"const": "versioned"}, "reference_id": {"$ref": "#/$defs/Id"}, "content_version": {"$ref": "#/$defs/Id"}, "source_labels": {"$ref": "#/$defs/SourceLabels"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "text", "content_digest", "source_labels"], "properties": {"kind": {"const": "materialized_text"}, "text": {"type": "string"}, "content_digest": {"$ref": "#/$defs/Digest"}, "source_labels": {"$ref": "#/$defs/SourceLabels"}}}
      ]
    },
    "Block": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "text", "source_labels"], "properties": {"kind": {"enum": ["system", "conversation", "content"]}, "text": {"type": "string"}, "source_labels": {"$ref": "#/$defs/SourceLabels"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "call_id", "tool_name", "arguments_json", "source_labels"], "properties": {"kind": {"const": "tool_call"}, "call_id": {"$ref": "#/$defs/Id"}, "tool_name": {"$ref": "#/$defs/Id"}, "arguments_json": {"type": "string"}, "source_labels": {"$ref": "#/$defs/SourceLabels"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "call_id", "result_text", "source_labels"], "properties": {"kind": {"const": "tool_result"}, "call_id": {"$ref": "#/$defs/Id"}, "result_text": {"type": "string"}, "source_labels": {"$ref": "#/$defs/SourceLabels"}}}
      ]
    },
    "Message": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "blocks"],
      "properties": {"role": {"enum": ["system", "user", "assistant", "tool"]}, "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Block"}}}
    },
    "ToolDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "input_schema"],
      "properties": {"name": {"$ref": "#/$defs/Id"}, "description": {"type": "string"}, "input_schema": {"type": "object"}}
    },
    "Destination": {
      "type": "object", "additionalProperties": false,
      "required": ["service", "endpoint", "model", "model_version", "processing_region"],
      "properties": {"service": {"$ref": "#/$defs/Id"}, "endpoint": {"$ref": "#/$defs/Id"}, "model": {"$ref": "#/$defs/Id"}, "model_version": {"$ref": "#/$defs/Id"}, "processing_region": {"$ref": "#/$defs/Id"}, "pool": {"$ref": "#/$defs/Id"}, "quantization": {"$ref": "#/$defs/Id"}}
    },
    "ResolvedPrompt": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt_id", "prompt_version", "resolved_digest"],
      "properties": {"prompt_id": {"$ref": "#/$defs/Id"}, "prompt_version": {"$ref": "#/$defs/Id"}, "resolved_digest": {"$ref": "#/$defs/Digest"}}
    },
    "GenerationSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["max_output_tokens", "temperature_decimal", "total_timeout_ms"],
      "properties": {"max_output_tokens": {"$ref": "#/$defs/SafeCount"}, "temperature_decimal": {"$ref": "#/$defs/Decimal"}, "total_timeout_ms": {"$ref": "#/$defs/SafeCount"}, "seed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "response_format": {"enum": ["text", "tool"]}}
    },
    "SubmitRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "profile", "task_id", "task_class", "step_class", "step_id", "step_revision", "execution_generation", "purpose", "requested_destination", "resolved_prompt", "messages", "generation_settings", "deadline"],
      "properties": {
        "contract_version": {"$ref": "#/$defs/Version"}, "profile": {"const": "initial_1a"},
        "task_id": {"$ref": "#/$defs/Id"}, "subtask_id": {"$ref": "#/$defs/Id"}, "session_id": {"$ref": "#/$defs/Id"}, "task_class": {"$ref": "#/$defs/Id"}, "step_class": {"$ref": "#/$defs/Id"}, "step_id": {"$ref": "#/$defs/Id"}, "step_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "execution_generation": {"$ref": "#/$defs/Id"}, "purpose": {"$ref": "#/$defs/Purpose"},
        "claimed_principal_id": {"$ref": "#/$defs/Id"}, "claimed_charging_owner_id": {"$ref": "#/$defs/Id"},
        "requested_destination": {"$ref": "#/$defs/Destination"}, "resolved_prompt": {"$ref": "#/$defs/ResolvedPrompt"}, "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Message"}},
        "tool_definitions": {"type": "array", "items": {"$ref": "#/$defs/ToolDefinition"}}, "tool_choice": {"enum": ["auto", "none", "required"]}, "references": {"type": "array", "items": {"$ref": "#/$defs/Reference"}},
        "generation_settings": {"$ref": "#/$defs/GenerationSettings"}, "deadline": {"$ref": "#/$defs/UtcTime"}, "trace_context": {"type": "object", "additionalProperties": {"type": "string"}}, "observed_at": {"$ref": "#/$defs/UtcTime"}
      }
    },
    "Error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "correlation_id", "retry_guidance"],
      "properties": {"code": {"enum": ["SCHEMA_INVALID", "UNSUPPORTED_VERSION", "AUTHENTICATION_FAILED", "AUTHORITY_INVALID", "CLASSIFICATION_REQUIRED", "HANDLING_CONFLICT", "DESTINATION_FORBIDDEN", "CONFIGURATION_NOT_APPROVED", "CAPABILITY_UNSUPPORTED", "WORK_CONFLICT", "PLAN_INVALID_OR_STALE", "FDC_REJECTED", "INTENT_PERSIST_FAILED", "TRANSPORT_OUTCOME_UNKNOWN", "CANCELLATION_UNCONFIRMED", "USAGE_UNKNOWN", "INTERNAL_UNAVAILABLE"]}, "correlation_id": {"$ref": "#/$defs/Id"}, "retry_guidance": {"enum": ["never", "same_generation_after_query", "orchestrator_decision"]}, "safe_message": {"type": "string"}}
    },
    "SubmitAck": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "receipt_state", "correlation_id"],
      "properties": {"contract_version": {"$ref": "#/$defs/Version"}, "receipt_state": {"enum": ["received", "rejected"]}, "correlation_id": {"$ref": "#/$defs/Id"}, "submission_id": {"$ref": "#/$defs/Id"}, "error": {"$ref": "#/$defs/Error"}}
    },
    "StatusQuery": {"type": "object", "additionalProperties": false, "required": ["contract_version", "submission_id"], "properties": {"contract_version": {"$ref": "#/$defs/Version"}, "submission_id": {"$ref": "#/$defs/Id"}}},
    "StatusSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "submission_id", "status_revision", "submission_state", "attempts", "updated_at"],
      "properties": {"contract_version": {"$ref": "#/$defs/Version"}, "submission_id": {"$ref": "#/$defs/Id"}, "status_revision": {"$ref": "#/$defs/SafeCount"}, "submission_state": {"enum": ["received", "rejected", "admitted", "no_route"]}, "attempts": {"type": "array", "items": {"$ref": "#/$defs/AttemptRecord"}}, "updated_at": {"$ref": "#/$defs/UtcTime"}, "step_verdict": {"enum": ["pending", "accepted", "rejected", "superseded"]}, "task_outcome": {"enum": ["open", "accepted", "failed", "abandoned"]}, "error": {"$ref": "#/$defs/Error"}}
    },
    "CancelRequest": {"type": "object", "additionalProperties": false, "required": ["contract_version", "submission_id", "execution_generation", "reason"], "properties": {"contract_version": {"$ref": "#/$defs/Version"}, "submission_id": {"$ref": "#/$defs/Id"}, "execution_generation": {"$ref": "#/$defs/Id"}, "reason": {"type": "string", "minLength": 1}}},
    "CancelAck": {"type": "object", "additionalProperties": false, "required": ["contract_version", "submission_id", "cancellation_state"], "properties": {"contract_version": {"$ref": "#/$defs/Version"}, "submission_id": {"$ref": "#/$defs/Id"}, "cancellation_state": {"enum": ["requested", "confirmed", "unresolved"]}, "attempt_id": {"$ref": "#/$defs/Id"}}},
    "OutcomeEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "event_id", "task_id", "step_id", "step_revision", "execution_generation", "outcome_revision", "step_verdict", "task_outcome", "occurred_at"],
      "properties": {"contract_version": {"$ref": "#/$defs/Version"}, "event_id": {"$ref": "#/$defs/Id"}, "task_id": {"$ref": "#/$defs/Id"}, "step_id": {"$ref": "#/$defs/Id"}, "step_revision": {"type": "integer", "minimum": 1}, "execution_generation": {"$ref": "#/$defs/Id"}, "outcome_revision": {"type": "integer", "minimum": 1}, "step_verdict": {"enum": ["pending", "accepted", "rejected", "superseded"]}, "task_outcome": {"enum": ["open", "accepted", "failed", "abandoned"]}, "occurred_at": {"$ref": "#/$defs/UtcTime"}, "evidence_ref": {"$ref": "#/$defs/Id"}, "parent_event_id": {"$ref": "#/$defs/Id"}}
    },
    "OutcomeAck": {"type": "object", "additionalProperties": false, "required": ["contract_version", "event_id", "recorded"], "properties": {"contract_version": {"$ref": "#/$defs/Version"}, "event_id": {"$ref": "#/$defs/Id"}, "recorded": {"type": "boolean"}, "error": {"$ref": "#/$defs/Error"}}},
    "CapabilityResponse": {"type": "object", "additionalProperties": false, "required": ["contract_version", "profile", "profile_version", "enabled_features"], "properties": {"contract_version": {"$ref": "#/$defs/Version"}, "profile": {"const": "initial_1a"}, "profile_version": {"$ref": "#/$defs/Id"}, "enabled_features": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "ExecutionPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "signature", "expires_at", "work_digest", "principal_id", "purpose", "task_id", "step_id", "step_revision", "execution_generation", "destination", "adapter_version", "policy_version", "recovery_policy_version", "registry_version", "capability_profile_version", "classification_snapshot", "financial_scope", "deadline"],
      "properties": {"plan_id": {"$ref": "#/$defs/Id"}, "signature": {"type": "string", "minLength": 1, "description": "Symbolic in vectors; no client signing authority"}, "expires_at": {"$ref": "#/$defs/UtcTime"}, "work_digest": {"$ref": "#/$defs/Digest"}, "principal_id": {"$ref": "#/$defs/Id"}, "purpose": {"$ref": "#/$defs/Purpose"}, "task_id": {"$ref": "#/$defs/Id"}, "step_id": {"$ref": "#/$defs/Id"}, "step_revision": {"type": "integer", "minimum": 1}, "execution_generation": {"$ref": "#/$defs/Id"}, "destination": {"$ref": "#/$defs/Destination"}, "adapter_version": {"$ref": "#/$defs/Id"}, "policy_version": {"$ref": "#/$defs/Id"}, "recovery_policy_version": {"$ref": "#/$defs/Id"}, "registry_version": {"$ref": "#/$defs/Id"}, "capability_profile_version": {"$ref": "#/$defs/Id"}, "classification_snapshot": {"$ref": "#/$defs/SourceLabels"}, "financial_scope": {"type": "object"}, "deadline": {"$ref": "#/$defs/UtcTime"}, "permitted_fallbacks": {"type": "array", "items": {"$ref": "#/$defs/Destination"}}, "retention_class": {"$ref": "#/$defs/Id"}}
    },
    "PreparedCandidate": {"type": "object", "additionalProperties": false, "required": ["plan_id", "work_digest", "destination", "adapter_version", "prepared_request_digest", "callbacks_complete"], "properties": {"plan_id": {"$ref": "#/$defs/Id"}, "work_digest": {"$ref": "#/$defs/Digest"}, "destination": {"$ref": "#/$defs/Destination"}, "adapter_version": {"$ref": "#/$defs/Id"}, "prepared_request_digest": {"$ref": "#/$defs/Digest"}, "callbacks_complete": {"const": true}}},
    "DispatchIntent": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "plan_id", "prepared_request_digest", "fdc_passed_at", "durably_recorded_at", "destination"], "properties": {"attempt_id": {"$ref": "#/$defs/Id"}, "plan_id": {"$ref": "#/$defs/Id"}, "prepared_request_digest": {"$ref": "#/$defs/Digest"}, "fdc_passed_at": {"$ref": "#/$defs/UtcTime"}, "durably_recorded_at": {"$ref": "#/$defs/UtcTime"}, "destination": {"$ref": "#/$defs/Destination"}}},
    "NormalizedUsage": {"type": "object", "additionalProperties": false, "required": ["input_uncached", "input_cache_read", "input_cache_write", "output_text", "output_reasoning", "other_billable"], "properties": {"input_uncached": {"$ref": "#/$defs/SafeCount"}, "input_cache_read": {"$ref": "#/$defs/SafeCount"}, "input_cache_write": {"$ref": "#/$defs/SafeCount"}, "output_text": {"$ref": "#/$defs/SafeCount"}, "output_reasoning": {"$ref": "#/$defs/SafeCount"}, "other_billable": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["component", "unit", "count"], "properties": {"component": {"$ref": "#/$defs/Id"}, "unit": {"$ref": "#/$defs/Id"}, "count": {"$ref": "#/$defs/SafeCount"}}}}}},
    "UsageRevision": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "revision", "usage_status", "usage_semantics_version", "price_version", "currency", "recorded_at"],
      "properties": {"attempt_id": {"$ref": "#/$defs/Id"}, "revision": {"type": "integer", "minimum": 1}, "previous_revision": {"type": "integer", "minimum": 1}, "usage_status": {"enum": ["unknown", "reported", "calculated", "estimated", "reconciled"]}, "usage_semantics_version": {"$ref": "#/$defs/Id"}, "price_version": {"$ref": "#/$defs/Id"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "raw_provider_usage": {"type": "object"}, "normalized_usage": {"$ref": "#/$defs/NormalizedUsage"}, "amount_decimal": {"$ref": "#/$defs/Decimal"}, "estimate_method": {"type": "string"}, "processing_region": {"$ref": "#/$defs/Id"}, "recorded_at": {"$ref": "#/$defs/UtcTime"}}
    },
    "AttemptRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "execution_generation", "attempt_state", "delivery_state", "structural_status"],
      "properties": {"attempt_id": {"$ref": "#/$defs/Id"}, "execution_generation": {"$ref": "#/$defs/Id"}, "provider_request_id": {"$ref": "#/$defs/Id"}, "attempt_state": {"enum": ["prepared", "fdc_rejected", "intent_persisted", "transmitted", "response_received", "outcome_unknown", "cancel_requested", "cancel_confirmed", "failed_before_dispatch", "settled"]}, "delivery_state": {"enum": ["none", "candidate_delivered"]}, "structural_status": {"enum": ["not_checked", "pass", "fail"]}, "usage_revision": {"$ref": "#/$defs/UsageRevision"}}
    }
  }
}
