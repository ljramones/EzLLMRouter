{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mach33:ezllmrouter:external-accounting:1",
  "title": "EzLLMRouter external accounting integration v1",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$"},
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_id", "platform_id", "environment_id", "owner_id", "ingest_principal_id", "activated_at"],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/id"}, "platform_id": {"$ref": "#/$defs/id"},
        "environment_id": {"$ref": "#/$defs/id"}, "owner_id": {"$ref": "#/$defs/id"},
        "ingest_principal_id": {"$ref": "#/$defs/id"}, "activated_at": {"$ref": "#/$defs/utc"}
      }
    },
    "account": {
      "type": "object", "additionalProperties": false,
      "required": ["account_id", "dataset_id", "provider_id", "credential_ref", "allowed_models", "state"],
      "properties": {
        "account_id": {"$ref": "#/$defs/id"}, "dataset_id": {"$ref": "#/$defs/id"},
        "provider_id": {"$ref": "#/$defs/id"}, "credential_ref": {"$ref": "#/$defs/id"},
        "allowed_models": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}}, "state": {"enum": ["usable", "disabled"]}
      }
    },
    "account_state": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_id", "expected_revision", "state"],
      "properties": {"dataset_id": {"$ref": "#/$defs/id"},
        "expected_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "state": {"enum": ["usable", "disabled"]}}
    },
    "native_unit": {
      "type": "object", "additionalProperties": false, "required": ["unit", "quantity_decimal"],
      "properties": {"unit": {"$ref": "#/$defs/id"}, "quantity_decimal": {"$ref": "#/$defs/decimal"}}
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["integration_version", "event_id", "dataset_id", "kind", "occurred_at",
        "activity_kind", "task_id", "run_id", "root_run_id", "actor_kind", "actor_id"],
      "properties": {
        "integration_version": {"const": "1"}, "event_id": {"$ref": "#/$defs/id"},
        "dataset_id": {"$ref": "#/$defs/id"}, "kind": {"const": "activity"},
        "occurred_at": {"$ref": "#/$defs/utc"},
        "activity_kind": {"enum": ["task", "step", "tool", "delegation", "outcome"]},
        "task_id": {"$ref": "#/$defs/id"}, "step_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"}, "root_run_id": {"$ref": "#/$defs/id"},
        "parent_run_id": {"$ref": "#/$defs/id"},
        "actor_kind": {"enum": ["agent", "service", "human"]}, "actor_id": {"$ref": "#/$defs/id"},
        "outcome": {"enum": ["accepted", "rejected", "unknown"]}
      }
    },
    "attempt_started": {
      "type": "object", "additionalProperties": false,
      "required": ["integration_version", "event_id", "dataset_id", "kind", "occurred_at",
        "attempt_id", "started_at", "task_id", "step_id", "run_id", "root_run_id",
        "actor_kind", "actor_id", "provider_account_id", "model_id", "context_ref"],
      "properties": {
        "integration_version": {"const": "1"}, "event_id": {"$ref": "#/$defs/id"},
        "dataset_id": {"$ref": "#/$defs/id"}, "kind": {"const": "attempt_started"},
        "occurred_at": {"$ref": "#/$defs/utc"}, "attempt_id": {"$ref": "#/$defs/id"},
        "started_at": {"$ref": "#/$defs/utc"},
        "task_id": {"$ref": "#/$defs/id"}, "step_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"}, "root_run_id": {"$ref": "#/$defs/id"},
        "parent_run_id": {"$ref": "#/$defs/id"},
        "actor_kind": {"enum": ["agent", "service", "human"]}, "actor_id": {"$ref": "#/$defs/id"},
        "initiating_user_id": {"$ref": "#/$defs/id"},
        "provider_account_id": {"$ref": "#/$defs/id"}, "model_id": {"$ref": "#/$defs/id"},
        "context_ref": {"$ref": "#/$defs/id"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["integration_version", "event_id", "dataset_id", "kind", "occurred_at",
        "attempt_id", "decision_ref", "selected_account_id", "selected_model_id", "policy_version"],
      "properties": {
        "integration_version": {"const": "1"}, "event_id": {"$ref": "#/$defs/id"},
        "dataset_id": {"$ref": "#/$defs/id"}, "kind": {"const": "decision"},
        "occurred_at": {"$ref": "#/$defs/utc"}, "attempt_id": {"$ref": "#/$defs/id"},
        "decision_ref": {"$ref": "#/$defs/id"}, "selected_account_id": {"$ref": "#/$defs/id"},
        "selected_model_id": {"$ref": "#/$defs/id"}, "policy_version": {"$ref": "#/$defs/id"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["integration_version", "event_id", "dataset_id", "kind", "occurred_at",
        "attempt_id", "result_state"],
      "properties": {
        "integration_version": {"const": "1"}, "event_id": {"$ref": "#/$defs/id"},
        "dataset_id": {"$ref": "#/$defs/id"}, "kind": {"const": "result"},
        "occurred_at": {"$ref": "#/$defs/utc"}, "attempt_id": {"$ref": "#/$defs/id"},
        "result_state": {"enum": ["completed", "failed", "unknown"]},
        "result_ref": {"$ref": "#/$defs/id"}
      }
    },
    "usage_known": {
      "type": "object", "additionalProperties": false,
      "required": ["integration_version", "event_id", "dataset_id", "kind", "occurred_at",
        "attempt_id", "usage_revision", "usage_state", "currency", "amount_decimal",
        "cost_basis", "price_ref", "price_version", "native_units"],
      "properties": {
        "integration_version": {"const": "1"}, "event_id": {"$ref": "#/$defs/id"},
        "dataset_id": {"$ref": "#/$defs/id"}, "kind": {"const": "usage"},
        "occurred_at": {"$ref": "#/$defs/utc"}, "attempt_id": {"$ref": "#/$defs/id"},
        "usage_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "usage_state": {"const": "known"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "amount_decimal": {"$ref": "#/$defs/decimal"},
        "cost_basis": {"enum": ["provider_reported", "derived", "estimated", "reconciled"]},
        "price_ref": {"$ref": "#/$defs/id"}, "price_version": {"$ref": "#/$defs/id"},
        "native_units": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/native_unit"}},
        "zero_basis": {"$ref": "#/$defs/id"}
      }
    },
    "usage_unknown": {
      "type": "object", "additionalProperties": false,
      "required": ["integration_version", "event_id", "dataset_id", "kind", "occurred_at",
        "attempt_id", "usage_revision", "usage_state"],
      "properties": {
        "integration_version": {"const": "1"}, "event_id": {"$ref": "#/$defs/id"},
        "dataset_id": {"$ref": "#/$defs/id"}, "kind": {"const": "usage"},
        "occurred_at": {"$ref": "#/$defs/utc"}, "attempt_id": {"$ref": "#/$defs/id"},
        "usage_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "usage_state": {"const": "unknown"}
      }
    },
    "event": {
      "oneOf": [
        {"$ref": "#/$defs/activity"}, {"$ref": "#/$defs/attempt_started"},
        {"$ref": "#/$defs/decision"}, {"$ref": "#/$defs/result"},
        {"$ref": "#/$defs/usage_known"}, {"$ref": "#/$defs/usage_unknown"}
      ]
    }
  }
}
