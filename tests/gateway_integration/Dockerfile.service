ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_CONFIG_FILE=/dev/null \
    PYTHONPATH=/app/server:/app/gateway:/app/dev_slice
COPY wheels/ /opt/duranki/wheels/
COPY wheelhouse.sha256 /opt/duranki/wheelhouse.sha256
COPY requirements.gateway.lock /opt/duranki/requirements.gateway.lock
RUN cd /opt/duranki/wheels && sha256sum -c /opt/duranki/wheelhouse.sha256 \
 && python -m pip install --no-index --find-links=/opt/duranki/wheels --only-binary=:all: \
      --require-hashes -r /opt/duranki/requirements.gateway.lock \
 && python -m pip check \
 && rm -rf /opt/duranki/wheels
COPY server/ /app/server/
COPY gateway/ /app/gateway/
COPY dev_slice/ /app/dev_slice/
# Staging uses umask 077. Keep trusted code readable, but not writable, by UID 10001.
RUN find /app/server /app/gateway /app/dev_slice -type d -exec chmod 0555 {} + \
 && find /app/server /app/gateway /app/dev_slice -type f -exec chmod 0444 {} + \
 && chmod 0555 /app \
 && mkdir -p /data /link && chown 10001:10001 /data /link
USER 10001:10001
WORKDIR /app
RUN test -r /app/server/duranki_server/core.py && test -r /app/server/duranki_server/gateway/guard.py
CMD ["python", "/app/gateway/service_main.py"]
