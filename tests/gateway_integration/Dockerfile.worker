ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_CONFIG_FILE=/dev/null \
    PYTHONPATH=/app/worker
COPY wheels/ /opt/ezllmrouter/wheels/
COPY wheelhouse.sha256 /opt/ezllmrouter/wheelhouse.sha256
COPY requirements.gateway.lock /opt/ezllmrouter/requirements.gateway.lock
RUN cd /opt/ezllmrouter/wheels && sha256sum -c /opt/ezllmrouter/wheelhouse.sha256 \
 && python -m pip install --no-index --find-links=/opt/ezllmrouter/wheels --only-binary=:all: \
      --require-hashes -r /opt/ezllmrouter/requirements.gateway.lock \
 && python -m pip check \
 && rm -rf /opt/ezllmrouter/wheels
COPY choice_b_worker.py choice_b_wire.py worker_logging.py /app/worker/
COPY fixture/ /app/fixture/
RUN find /app/worker /app/fixture -type d -exec chmod 0555 {} + \
 && find /app/worker /app/fixture -type f -exec chmod 0444 {} + \
 && chmod 0555 /app \
 && mkdir -p /link && chown 10001:10001 /link
USER 10001:10001
WORKDIR /app
RUN test -r /app/worker/choice_b_worker.py \
 && test ! -e /app/server && test ! -e /app/dev_slice && test ! -e /app/gateway
CMD ["python", "/app/worker/choice_b_worker.py"]
