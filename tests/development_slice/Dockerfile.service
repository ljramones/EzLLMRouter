ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/server:/app
COPY requirements.lock /opt/ezllmrouter/requirements.lock
COPY wheels/ /opt/ezllmrouter/wheels/
RUN python -m pip install --no-index --find-links=/opt/ezllmrouter/wheels --require-hashes --only-binary=:all: -r /opt/ezllmrouter/requirements.lock \
 && rm -rf /opt/ezllmrouter/wheels \
      /usr/local/lib/python3.12/site-packages/pip /usr/local/lib/python3.12/site-packages/pip-*.dist-info \
      /usr/local/lib/python3.12/ensurepip /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12
COPY server/ /app/server/
COPY tests/ /app/tests/
RUN mkdir -p /data && chown 10001:10001 /data
USER 10001:10001
WORKDIR /app/tests
RUN test -r /app/server/ezllmrouter_server/canonical.py \
 && test -r /app/tests/test_crypto.py
CMD ["python", "/app/tests/service_main.py"]
